# Golf Cart Store — environment template. Copy to .env and fill real values.
# NEVER commit .env. Variable meanings: docs/IMPLEMENTATION_STATUS.md §3 (CFG register).

NODE_ENV=development

# CFG-01 PostgreSQL (required from Phase 03)
DATABASE_URL=

# CFG-02/03 Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# CFG-04 Transactional email
RESEND_API_KEY=
EMAIL_FROM=

# CFG-05 Object storage (product imagery)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth.js session secret (Phase 04) — generate: openssl rand -base64 32
AUTH_SECRET=

# CFG-08 Error tracking
NEXT_PUBLIC_SENTRY_DSN=

# CFG-06 Public site base URL — enables canonical/hreflang (no default invented)
NEXT_PUBLIC_SITE_URL=
